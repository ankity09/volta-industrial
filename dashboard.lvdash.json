              {"name": "ds_lines_plant", "query": {"datasetName": "ds_lines", "fields": [{"name": "plant_id", "expression": "`plant_id`"}], "disaggregated": false}}
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-multi-select",
              "encodings": {"fields": [
                {"fieldName": "plant_id", "displayName": "Plant", "queryName": "ds_exposure_plant"},
                {"fieldName": "plant_id", "displayName": "Plant", "queryName": "ds_lines_plant"}
              ]},
              "frame": {"showTitle": true, "title": "Plant"}
            }
          },
          "position": {"x": 0, "y": 0, "width": 4, "height": 2}
        },
        {
          "widget": {
            "name": "filter_machine",
