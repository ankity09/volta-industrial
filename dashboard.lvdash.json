{
  "datasets": [
    {
      "name": "ds_exposure",
      "displayName": "Exposure (metric view)",
      "queryLines": [
        "SELECT plant_id, machine_type, risk_band, criticality,\n",
        "       MEASURE(`downtime_exposure`) AS downtime_exposure_usd,\n",
        "       MEASURE(`open_work_orders`)  AS open_work_orders,\n",
        "       MEASURE(`critical_count`)    AS critical_count,\n",
        "       MEASURE(`atrisk_count`)      AS atrisk_count,\n",
        "       MEASURE(`line_count`)        AS line_count\n",
        "FROM mv_line_risk\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "ds_lines",
      "displayName": "Lines (current position)",
      "queryLines": [
        "SELECT line_id, plant_id, machine_type, criticality, plant_lat, plant_lng,\n",
        "       risk_band, failure_risk_score, vibration_rms, temperature_c,\n",
        "       open_wo_count, downtime_exposure_usd\n",
        "FROM gold_line_status\n",
        "WHERE risk_band != 'healthy' OR rand() < 0.1"
      ]
    },
    {
      "name": "ds_maintenance",
      "displayName": "Maintenance recommendations",
      "queryLines": [
        "SELECT line_id, recommended_action,\n",
        "       predicted_downtime_cost_avoided_usd, predicted_net_value_usd\n",
        "FROM gold_maintenance_recommendations"
      ]
    }
  ],
  "pages": [
    {
