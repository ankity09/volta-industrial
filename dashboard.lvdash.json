            }
          },
          "position": {"x": 4, "y": 0, "width": 4, "height": 2}
        },
        {
          "widget": {
            "name": "filter_riskband",
            "queries": [
              {"name": "ds_exposure_band", "query": {"datasetName": "ds_exposure", "fields": [{"name": "risk_band", "expression": "`risk_band`"}], "disaggregated": false}},
              {"name": "ds_lines_band", "query": {"datasetName": "ds_lines", "fields": [{"name": "risk_band", "expression": "`risk_band`"}], "disaggregated": false}}
