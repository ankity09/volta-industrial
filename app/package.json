{
  "name": "volta-plant-floor",
  "version": "1.0.0",
  "description": "Volta Industrial Plant Floor: predictive-maintenance decision app on Databricks Apps (AppKit + React + Lakebase).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/server.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "npm run build:source",
    "build:source": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js --tsconfig=tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@databricks/appkit": "0.66.1",
    "@databricks/appkit-ui": "0.66.1",
    "@openai/agents": "^0.17.0",
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "jsonc-parser": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.454.0",
    "mlflow-tracing": "^0.1.3",
    "openai": "^4.71.1",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router": "^7.1.1",
    "remark-gfm": "^4.0.0",
    "three": "^0.169.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.17.0",
    "rolldown": "^1.1.0",
    "tailwindcss": "^4.0.0",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "^0.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}